# LocalStack is the only AWS-compatible service used in Phase 3.
AWS_ETL_ENVIRONMENT=local
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ETL_BUCKET=ecommerce-sales-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ETL_MANIFEST_PREFIX=manifests/
AWS_ETL_AUDIT_PREFIX=audit/
AWS_ETL_PIPELINE_VERSION=1.0.0

# Supply the complete Olist CSV directory at invocation time; keep it outside Git.
DATASET_DIR=/absolute/path/to/olist
