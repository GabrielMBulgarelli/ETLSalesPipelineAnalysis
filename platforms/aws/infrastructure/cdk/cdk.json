{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "output": "cdk.out",
  "context": {
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "awsRegion": "us-east-1",
    "environment": "dev",
    "glueWorkerType": "G.1X",
    "glueWorkerCount": 2,
    "glueTimeoutMinutes": 60,
    "glueMaxConcurrency": 1,
    "redshiftBaseCapacity": 8,
    "redshiftMaxCapacity": 16,
    "redshiftMonthlyRpuHours": 40
  }
}
